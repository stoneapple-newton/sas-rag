# Copy this file to .env and fill in local secrets.
# Do not commit .env.

# Provider credentials for future embedding and LLM-backed retrieval steps.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4

# Optional LangSmith tracing for later ingestion/retrieval/MCP observability.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=sas-rag

# Local SAS ingestion defaults.
SAS_RAG_SOURCE_DIR=docs/sas-documents
SAS_RAG_WHITELIST=data/source_whitelist.json
SAS_RAG_INGESTION_OUT=data/ingestion/runs/latest
SAS_RAG_CHROMA_PATH=data/chroma
SAS_RAG_CHROMA_COLLECTION=sas_94_docs
